{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierscan.local/harness/agent-development-candidate-manifest.schema.json",
  "title": "FrontierScan Agent Development Candidate Manifest",
  "type": "object",
  "required": ["schemaVersion", "storyId", "runId", "dispatchId", "taskId", "role", "baseCommit", "headCommit", "worktreePath", "baselineSha256", "afterSha256", "gitStatusSha256", "files", "totalBytes", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "storyId": {"type": "string"}, "runId": {"type": "string"}, "dispatchId": {"type": "string", "format": "uuid"}, "taskId": {"type": "string"},
    "role": {"enum": ["backend-developer", "frontend-developer"]}, "baseCommit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "headCommit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "worktreePath": {"type": "string"}, "baselineSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "afterSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "gitStatusSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "changeType", "sha256", "bytes", "kind"], "properties": {"path": {"type": "string"}, "changeType": {"enum": ["create", "update"]}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0, "maximum": 2097152}, "kind": {"enum": ["backend", "frontend", "phase-output"]}}, "additionalProperties": false}},
    "totalBytes": {"type": "integer", "minimum": 0, "maximum": 8388608}, "createdAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
