{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierscan.local/harness/worktree-wave-receipt.schema.json",
  "title": "FrontierScan Harness Wave Receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "storyId",
    "runId",
    "phase",
    "waveId",
    "waveIndex",
    "preparedRevision",
    "integrationManifestFile",
    "integrationManifestSha256",
    "tasks",
    "phaseArtifacts",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "storyId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "phase": { "const": "implementation" },
    "waveId": { "type": "string", "pattern": "^wave-[a-f0-9]{16}$" },
    "waveIndex": { "type": "integer", "minimum": 1 },
    "preparedRevision": { "type": "integer", "minimum": 1 },
    "integrationManifestFile": { "type": "string", "minLength": 1 },
    "integrationManifestSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "tasks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "taskId",
          "dispatchId",
          "resultFile",
          "resultSha256",
          "executionReceiptFile",
          "executionReceiptSha256",
          "integrationReceiptFile",
          "integrationReceiptSha256"
        ],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "dispatchId": { "type": "string", "format": "uuid" },
          "resultFile": { "type": "string", "minLength": 1 },
          "resultSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "executionReceiptFile": { "type": "string", "minLength": 1 },
          "executionReceiptSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "integrationReceiptFile": { "type": "string", "minLength": 1 },
          "integrationReceiptSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "phaseArtifacts": {
      "type": "object",
      "required": [
        "taskFile",
        "taskSha256",
        "resultFile",
        "resultSha256",
        "notesFile",
        "notesSha256"
      ],
      "properties": {
        "taskFile": { "type": "string", "minLength": 1 },
        "taskSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "resultFile": { "type": "string", "minLength": 1 },
        "resultSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "notesFile": { "type": "string", "minLength": 1 },
        "notesSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
