{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierscan.local/harness/worktree-wave-retirement-receipt.schema.json",
  "title": "FrontierScan Harness Wave Worktree Retirement Receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "storyId",
    "runId",
    "waveId",
    "waveIndex",
    "retirementId",
    "statePhase",
    "stateRuntimeStatus",
    "stateFile",
    "stateSha256",
    "stateEventsFile",
    "stateEventsSha256",
    "stateBackupFile",
    "stateBackupSha256",
    "taskDagFile",
    "taskDagSha256",
    "wavePlanFile",
    "wavePlanSha256",
    "creationReceiptFile",
    "creationReceiptSha256",
    "integrationManifestFile",
    "integrationManifestSha256",
    "waveLedgerFile",
    "waveLedgerSha256",
    "waveReceiptFile",
    "waveReceiptSha256",
    "implementationTaskFile",
    "implementationTaskSha256",
    "implementationResultFile",
    "implementationResultSha256",
    "implementationCheckpointFile",
    "implementationCheckpointSha256",
    "implementationNotesFile",
    "implementationNotesSha256",
    "tasks",
    "appliedFiles",
    "retiredAt",
    "recovered"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "storyId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "waveId": { "type": "string", "pattern": "^wave-[a-f0-9]{16}$" },
    "waveIndex": { "type": "integer", "minimum": 1 },
    "retirementId": { "type": "string", "format": "uuid" },
    "statePhase": { "const": "done" },
    "stateRuntimeStatus": { "const": "completed" },
    "stateFile": { "type": "string", "minLength": 1 },
    "stateSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "stateEventsFile": { "type": "string", "minLength": 1 },
    "stateEventsSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "stateBackupFile": { "type": "string", "minLength": 1 },
    "stateBackupSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "taskDagFile": { "type": "string", "minLength": 1 },
    "taskDagSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "wavePlanFile": { "type": "string", "minLength": 1 },
    "wavePlanSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "creationReceiptFile": { "type": "string", "minLength": 1 },
    "creationReceiptSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "integrationManifestFile": { "type": "string", "minLength": 1 },
    "integrationManifestSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "waveLedgerFile": { "type": "string", "minLength": 1 },
    "waveLedgerSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "waveReceiptFile": { "type": "string", "minLength": 1 },
    "waveReceiptSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "implementationTaskFile": { "type": "string", "minLength": 1 },
    "implementationTaskSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "implementationResultFile": { "type": "string", "minLength": 1 },
    "implementationResultSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "implementationCheckpointFile": { "type": "string", "minLength": 1 },
    "implementationCheckpointSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "implementationNotesFile": { "type": "string", "minLength": 1 },
    "implementationNotesSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "tasks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["taskId", "retirementReceiptFile", "retirementReceiptSha256"],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "retirementReceiptFile": { "type": "string", "minLength": 1 },
          "retirementReceiptSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "appliedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["taskId", "path", "type", "sha256", "bytes"],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["backend", "frontend", "phase-output"] },
          "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "retiredAt": { "type": "string", "format": "date-time" },
    "recovered": { "type": "boolean" }
  },
  "additionalProperties": false
}
