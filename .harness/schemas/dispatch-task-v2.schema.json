{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierscan.local/harness/dispatch-task-v2.schema.json",
  "title": "FrontierScan Harness Dispatch Task v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "dispatchId",
    "storyId",
    "runId",
    "phase",
    "ownerAgent",
    "purpose",
    "preparedRevision",
    "preparedAt",
    "resultSchemaVersion",
    "attemptRoot",
    "resultFile",
    "checkpointFile",
    "expectedOutputs",
    "allowedAdapters",
    "next"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "dispatchId": { "type": "string", "format": "uuid" },
    "storyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "phase": { "type": "string", "minLength": 1 },
    "ownerAgent": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "preparedRevision": { "type": "integer", "minimum": 1 },
    "preparedAt": { "type": "string", "format": "date-time" },
    "resultSchemaVersion": { "const": "2.0" },
    "attemptRoot": {
      "type": "string",
      "pattern": "^\\.harness/runs/[A-Za-z0-9][A-Za-z0-9._-]{0,63}/phases/[0-9]{2,}-.+/attempts/[0-9a-fA-F-]{36}$"
    },
    "resultFile": { "type": "string", "pattern": "/result\\.json$" },
    "checkpointFile": { "type": "string", "pattern": "/checkpoint\\.json$" },
    "expectedOutputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "allowedAdapters": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "next": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
