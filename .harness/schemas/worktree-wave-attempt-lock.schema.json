{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierscan.local/harness/worktree-wave-attempt-lock.schema.json",
  "title": "FrontierScan Harness Wave Attempt Lock",
  "type": "object",
  "required": [
    "schemaVersion", "storyId", "runId", "waveId", "taskId",
    "attemptId", "claimId", "lockId", "pid", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "storyId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "waveId": { "type": "string", "pattern": "^wave-[a-f0-9]{16}$" },
    "taskId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "pattern": "^attempt-[a-f0-9]{16}$" },
    "claimId": { "type": "string", "pattern": "^claim-[a-f0-9]{16}$" },
    "lockId": { "type": "string", "pattern": "^lock-[a-f0-9]{16}$" },
    "pid": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
