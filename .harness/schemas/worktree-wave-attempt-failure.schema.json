{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierscan.local/harness/worktree-wave-attempt-failure.schema.json",
  "title": "FrontierScan Harness Wave Attempt Failure",
  "type": "object",
  "required": [
    "schemaVersion", "storyId", "runId", "waveId", "taskId",
    "attemptId", "claimId", "lockId", "status", "reason",
    "claimSha256", "executionLockSha256", "recoveredAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "storyId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "waveId": { "type": "string", "pattern": "^wave-[a-f0-9]{16}$" },
    "taskId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "pattern": "^attempt-[a-f0-9]{16}$" },
    "claimId": { "type": "string", "pattern": "^claim-[a-f0-9]{16}$" },
    "lockId": { "type": "string", "pattern": "^lock-[a-f0-9]{16}$" },
    "status": { "type": "string", "enum": ["abandoned", "blocked"] },
    "reason": { "type": "string", "minLength": 1 },
    "claimSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "executionLockSha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "recoveredAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
