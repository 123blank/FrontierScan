{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierscan.local/harness/agent-development-request.schema.json",
  "title": "FrontierScan Agent Development Request",
  "type": "object",
  "required": ["schemaVersion", "providerRequestId", "dispatchId", "storyId", "runId", "phase", "preparedRevision", "taskId", "role", "profile", "adapter", "requestedModel", "modelSource", "modelProvider", "configSha256", "taskFile", "taskSha256", "taskDagFile", "taskDagSha256", "worktreePlanFile", "worktreePlanSha256", "worktreeStatusFile", "worktreeStatusSha256", "worktreePath", "baseCommit", "policy", "contextManifestFile", "contextManifestSha256", "outputSchemaFile", "outputSchemaSha256", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "providerRequestId": {"type": "string", "format": "uuid"},
    "dispatchId": {"type": "string", "format": "uuid"},
    "storyId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "phase": {"const": "implementation"},
    "preparedRevision": {"type": "integer", "minimum": 1},
    "taskId": {"type": "string", "minLength": 1},
    "role": {"enum": ["backend-developer", "frontend-developer"]},
    "profile": {"type": "string", "minLength": 1},
    "adapter": {"const": "codex-cli"},
    "requestedModel": {"type": ["string", "null"]},
    "modelSource": {"enum": ["runtime-override", "local-config", "project-config", "builtin-default"]},
    "modelProvider": {"type": ["object", "null"]},
    "configSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "taskFile": {"type": "string", "minLength": 1},
    "taskSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "taskDagFile": {"type": "string", "minLength": 1},
    "taskDagSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "worktreePlanFile": {"type": "string", "minLength": 1},
    "worktreePlanSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "worktreeStatusFile": {"type": "string", "minLength": 1},
    "worktreeStatusSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "worktreePath": {"type": "string", "minLength": 1},
    "baseCommit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "policy": {
      "type": "object",
      "required": ["name", "category", "readPathPrefixes", "writePathPrefixes", "capabilities"],
      "properties": {
        "name": {"enum": ["backend-developer", "frontend-developer"]},
        "category": {"const": "execution"},
        "readPathPrefixes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "writePathPrefixes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "contextManifestFile": {"type": "string", "minLength": 1},
    "contextManifestSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "outputSchemaFile": {"type": "string", "minLength": 1},
    "outputSchemaSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
