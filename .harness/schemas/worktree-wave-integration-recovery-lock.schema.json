{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierscan.local/harness/worktree-wave-integration-recovery-lock.schema.json",
  "title": "FrontierScan Harness Wave Integration Recovery Lock",
  "type": "object",
  "required": [
    "schemaVersion",
    "lockId",
    "freezeId",
    "manifestSha256",
    "storyId",
    "runId",
    "waveId",
    "pid",
    "createdAt",
    "integrationLockSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "lockId": { "type": "string", "minLength": 1 },
    "freezeId": { "type": "string", "minLength": 1 },
    "manifestSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "storyId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "waveId": { "type": "string", "pattern": "^wave-[a-f0-9]{16}$" },
    "pid": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "integrationLockSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
