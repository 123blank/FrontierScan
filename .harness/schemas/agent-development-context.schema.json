{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierscan.local/harness/agent-development-context.schema.json",
  "title": "FrontierScan Agent Development Context",
  "type": "object",
  "required": ["schemaVersion", "storyId", "runId", "dispatchId", "taskId", "role", "entries", "knowledgeAreas", "predictedFiles", "criterionIds", "worktree", "totalBytes", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "storyId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "dispatchId": {"type": "string", "format": "uuid"},
    "taskId": {"type": "string", "minLength": 1},
    "role": {"enum": ["backend-developer", "frontend-developer"]},
    "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "bytes", "purpose", "source"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0, "maximum": 2097152}, "purpose": {"type": "string", "minLength": 1}, "source": {"enum": ["task", "state", "dag", "knowledge", "policy", "source", "test-evidence", "project-rule"]}}, "additionalProperties": false}},
    "knowledgeAreas": {"type": "array", "items": {"type": "object", "required": ["area", "status", "loadedFiles"], "properties": {"area": {"enum": ["backend", "frontend", "common"]}, "status": {"enum": ["fresh", "accepted-stale"]}, "loadedFiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false}},
    "predictedFiles": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "criterionIds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "worktree": {"type": "object", "required": ["planFile", "planSha256", "statusFile", "statusSha256", "path", "branch", "baseCommit", "headCommit"], "properties": {"planFile": {"type": "string"}, "planSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "statusFile": {"type": "string"}, "statusSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "path": {"type": "string"}, "branch": {"type": "string"}, "baseCommit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "headCommit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}}, "additionalProperties": false},
    "totalBytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
