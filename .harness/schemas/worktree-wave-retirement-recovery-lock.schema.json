{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierscan.local/harness/worktree-wave-retirement-recovery-lock.schema.json",
  "title": "FrontierScan Harness Wave Worktree Retirement Recovery Lock",
  "type": "object",
  "required": [
    "schemaVersion",
    "lockId",
    "retirementId",
    "mode",
    "storyId",
    "runId",
    "waveId",
    "waveIndex",
    "wavePlanSha256",
    "creationReceiptSha256",
    "waveLedgerSha256",
    "waveReceiptSha256",
    "pid",
    "createdAt",
    "retirementLockFile",
    "retirementLockSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "lockId": { "type": "string", "format": "uuid" },
    "retirementId": { "type": "string", "format": "uuid" },
    "mode": { "type": "string", "enum": ["recovery"] },
    "storyId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "waveId": { "type": "string", "pattern": "^wave-[a-f0-9]{16}$" },
    "waveIndex": { "type": "integer", "minimum": 1 },
    "wavePlanSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "creationReceiptSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "waveLedgerSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "waveReceiptSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "pid": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "retirementLockFile": { "type": "string", "minLength": 1 },
    "retirementLockSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
