{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierscan.local/harness/serial-batch-ledger.schema.json",
  "title": "FrontierScan Harness Serial Batch Ledger",
  "type": "object",
  "required": [
    "schemaVersion",
    "storyId",
    "runId",
    "stateFile",
    "phase",
    "preparedRevision",
    "batchId",
    "taskDagFile",
    "taskDagSha256",
    "baseRef",
    "baseCommit",
    "ledgerFile",
    "lockFile",
    "batchPlanFile",
    "batchPlanSha256",
    "batchReceiptFile",
    "batchReceiptSha256",
    "status",
    "preparedAt",
    "finalizedAt",
    "tasks"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "storyId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "stateFile": { "type": "string", "minLength": 1 },
    "phase": { "const": "implementation" },
    "preparedRevision": { "type": "integer", "minimum": 1 },
    "batchId": { "type": "string", "pattern": "^batch-[a-f0-9]{16}$" },
    "taskDagFile": { "type": "string", "minLength": 1 },
    "taskDagSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "baseRef": { "type": "string", "minLength": 1 },
    "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "ledgerFile": { "type": "string", "minLength": 1 },
    "lockFile": { "type": "string", "minLength": 1 },
    "batchPlanFile": { "type": "string", "minLength": 1 },
    "batchPlanSha256": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "batchReceiptFile": { "type": "string", "minLength": 1 },
    "batchReceiptSha256": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": {
      "type": "string",
      "enum": ["prepared", "active", "blocked", "ready-for-finalization", "finalized"]
    },
    "preparedAt": { "type": "string", "minLength": 1 },
    "finalizedAt": { "type": ["string", "null"] },
    "tasks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "taskId",
          "title",
          "type",
          "ownerAgent",
          "wave",
          "sequence",
          "dispatchId",
          "predictedFiles",
          "taskRoot",
          "taskFile",
          "resultFile",
          "checkpointFile",
          "reportFile",
          "expectedOutputs",
          "inheritedSnapshotFile",
          "inheritedSnapshotSha256",
          "executionReceiptFile",
          "executionReceiptSha256",
          "integrationReceiptFile",
          "integrationReceiptSha256",
          "status",
          "startedAt",
          "workerReadyAt",
          "integratedAt"
        ],
        "properties": {
          "taskId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["backend", "frontend"] },
          "ownerAgent": { "type": "string", "minLength": 1 },
          "wave": { "type": "integer", "minimum": 1 },
          "sequence": { "type": "integer", "minimum": 1 },
          "dispatchId": { "type": "string", "format": "uuid" },
          "predictedFiles": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "taskRoot": { "type": "string", "minLength": 1 },
          "taskFile": { "type": "string", "minLength": 1 },
          "resultFile": { "type": "string", "minLength": 1 },
          "checkpointFile": { "type": "string", "minLength": 1 },
          "reportFile": { "type": "string", "minLength": 1 },
          "expectedOutputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "inheritedSnapshotFile": { "type": "string", "minLength": 1 },
          "inheritedSnapshotSha256": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
          "executionReceiptFile": { "type": "string", "minLength": 1 },
          "executionReceiptSha256": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
          "integrationReceiptFile": { "type": "string", "minLength": 1 },
          "integrationReceiptSha256": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
          "status": {
            "type": "string",
            "enum": ["pending", "running", "ready-for-integration", "integrated", "blocked"]
          },
          "startedAt": { "type": ["string", "null"] },
          "workerReadyAt": { "type": ["string", "null"] },
          "integratedAt": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
