{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierscan.local/harness/owned-manifest.schema.json",
  "title": "FrontierScan Owned Manifest",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/|[A-Za-z]:|.*\\\\|.*(?:^|/)\\.\\.?/).+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "oid": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  },
  "type": "object",
  "required": ["schemaVersion", "storyId", "runId", "baselineHead", "entries", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "storyId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "baselineHead": { "$ref": "#/$defs/oid" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "changeKind", "sourcePath", "contentSha256", "blobOid", "mode"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "changeKind": { "enum": ["added", "modified", "deleted", "renamed", "copied"] },
          "sourcePath": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/path" }] },
          "contentSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
          "blobOid": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/oid" }] },
          "mode": { "enum": [null, "100644", "100755"] }
        },
        "allOf": [
          {
            "if": { "properties": { "changeKind": { "const": "deleted" } }, "required": ["changeKind"] },
            "then": {
              "properties": {
                "sourcePath": { "type": "null" },
                "contentSha256": { "type": "null" },
                "blobOid": { "type": "null" },
                "mode": { "type": "null" }
              }
            },
            "else": {
              "properties": {
                "contentSha256": { "$ref": "#/$defs/sha256" },
                "blobOid": { "$ref": "#/$defs/oid" },
                "mode": { "enum": ["100644", "100755"] }
              }
            }
          },
          {
            "if": { "properties": { "changeKind": { "enum": ["renamed", "copied"] } }, "required": ["changeKind"] },
            "then": { "properties": { "sourcePath": { "$ref": "#/$defs/path" } } },
            "else": { "properties": { "sourcePath": { "type": "null" } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
